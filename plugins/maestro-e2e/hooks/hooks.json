{
  "description": "화면 코드를 바꾼 작업은 그 뒤에 만든 Maestro 결과(JUnit 리포트나 건너뛴 이유)가 있어야 마치게 한다. 새 화면이면 Flow를 만들지 묻게 한다.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-reminder.sh\" mark",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
